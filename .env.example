# Server
PORT=4321

# Firebase / Firestore (preferred store)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account for Admin / Firestore writes (pick one)
# Path relative to repo root, or absolute:
GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-admin.json
# Or the full service-account JSON as a single line:
# FIREBASE_SERVICE_ACCOUNT=

# Optional: Firestore emulator
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Gemini (optional — mock/keyword parser if missing)
GEMINI_API_KEY=

# Google Places (optional — reserved for nearby restaurant lookup)
PLACES_API_KEY=

# Headless Chromium on Vercel (optional). Defaults to Sparticuz v153 x64 pack.
# Set this if GitHub downloads fail; host the same .tar yourself (e.g. Vercel Blob).
# CHROMIUM_REMOTE_URL=https://github.com/Sparticuz/chromium/releases/download/v153.0.0/chromium-v153.0.0-pack.x64.tar
# Local Chrome override (optional — auto-detects Chrome/Edge on Windows/macOS/Linux)
# CHROME_PATH=

# Host session cookie
AUTH_SECRET=

# Collaboration invite emails (Resend). Without these the invite is still saved
# and shown as a notification after login, but no email is sent.
# RESEND_API_KEY=
# Must be an address on a domain verified in Resend (Domains). The shared test
# sender onboarding@resend.dev only delivers to your own Resend account email.
# MAIL_FROM="dietre <invites@your-verified-domain.com>"
# Public URL used in invite emails (falls back to the request origin)
# APP_URL=http://localhost:4321
