# DietRe API (backend)

Copy to `.env` if you have credentials. Nothing here is required to run locally.

PORT=4377
HOST=0.0.0.0

# MongoDB Atlas (optional — JSON file fallback at backend/.data/store.json)
MONGODB_URI=
MONGODB_DB=dietre

# Gemini (optional — deterministic keyword parser if missing)
GEMINI_API_KEY=

# Signs organizer session tokens
AUTH_SECRET=
